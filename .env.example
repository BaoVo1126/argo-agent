# --- Local model (Ollama) ---
#
# Argo runs entirely on this machine. There is no API key and no quota.
#
# Leave OLLAMA_MODEL empty and llm/discover.py asks Ollama what is installed,
# keeps the models that report `tools` in their capabilities, and takes the
# smallest -- so this works on a machine that pulled something different.
# Set a name to pin one; a pinned name is used even if its capability list
# looks wrong, because you may know something the list does not.
#
# Measured on this CPU-only machine, per research run (planner + insight):
#
#   qwen2.5-coder:3b   3.1B   ~122 s
#   llama3.2           3.2B   ~119 s   (invented two domain hints; both dropped)
#   qwen2.5:7b         7.6B   ~203 s
#
# All three produced usable Vietnamese and all three passed the number guard.
# The capability flag says a model *accepts* tools; only a run says it works.
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

# A 3B model on CPU can take over a minute on a long prompt; the default
# urllib timeout would cut it off mid-generation and look like a failure.
OLLAMA_TIMEOUT_S=300

# --- Browser ---
HEADLESS=true
ACTION_TIMEOUT_MS=8000

# --- Agent loop budgets (testing / RPA modes) ---
MAX_STEPS=20
MAX_REPEATS=3
MAX_ELEMENTS=60
